# このファイルを「ユーザーの作業フォルダ」（seo-grit リポジトリの外）に .env としてコピーして値を埋める
# 例: cp <seo-grit>/.env.example ~/my-media/.env

# WordPress サイトの URL（末尾スラッシュなし）
WP_URL=https://example.com/blog

# WordPress のユーザー名
WP_USER=your-username

# アプリケーションパスワード（WP管理画面 > ユーザー > プロフィール で発行。スペース込みでそのまま貼る）
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"
